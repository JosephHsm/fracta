{
  "name": "@fracta/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "generate": "openapi-generator-cli generate -c ./openapi-generator.yaml && node scripts/prune-generated.mjs",
    "clean": "node -e \"require('node:fs').rmSync('src/generated',{recursive:true,force:true})\"",
    "regenerate": "pnpm clean && pnpm generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "typescript": "5.9.3"
  }
}
